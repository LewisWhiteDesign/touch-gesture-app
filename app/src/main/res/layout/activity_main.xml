<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <!-- Main switches -->
        <TextView
            style="@style/SectionHeader"
            android:text="Gestures" />

        <Switch
            android:id="@+id/switchEnabled"
            style="@style/SettingSwitch"
            android:text="Enable lock-screen gestures" />

        <TextView
            style="@style/SettingHint"
            android:text="Shake the phone twice, sharply, to toggle the torch." />

        <Switch
            android:id="@+id/switchFolded"
            style="@style/SettingSwitch"
            android:text="Only when folded (cover screen)" />

        <Switch
            android:id="@+id/switchLocked"
            style="@style/SettingSwitch"
            android:text="Only on the lock screen" />

        <TextView
            style="@style/SettingHint"
            android:text="Turn this off temporarily if you want to test gestures while unlocked." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Shake sensitivity"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/sensLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Low" />

            <RadioButton
                android:id="@+id/sensMed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Medium" />

            <RadioButton
                android:id="@+id/sensHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="High" />
        </RadioGroup>

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test torch now" />

        <TextView
            android:id="@+id/lastEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <!-- One-time setup -->
        <TextView
            style="@style/SectionHeader"
            android:text="One-time setup" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Allow notifications" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Let it run in the background" />

        <TextView
            style="@style/SettingHint"
            android:text="Samsung phones: also go to Settings → Battery → Background usage limits → Never sleeping apps, and add Lock Gestures. Otherwise Samsung may stop it after a while." />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open app info" />
    </LinearLayout>
</ScrollView>
